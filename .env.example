# MongoDB Atlas connection URI (required for production; uses local MongoDB replica set in preview when unset)
MONGODB_URI=

# JWT signing secret (use a strong random 64-char secret in production)
JWT_SECRET=

# Server port
PORT=3000

# Allowed frontend origin for CORS in production (e.g. https://khayre-wms.onrender.com)
CLIENT_URL=

# Environment mode (development | production)
NODE_ENV=development

# GEMINI_API_KEY: Automatically injected by AI Studio runtime
GEMINI_API_KEY=

# APP_URL: Automatically injected by AI Studio runtime
APP_URL=
